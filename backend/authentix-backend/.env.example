# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/authentix
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# Security & JWT
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION_MS=86400000

# Blockchain Integration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=your_ethereum_private_key_here
BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_contract_address_here
